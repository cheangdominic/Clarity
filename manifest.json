{
  "manifest_version": 3,
  "name": "Clarity",
  "version": "1.0.0",
  "description": "A chrome extension designed for students, researchers, and anyone who reads online, Clarity transforms passive reading into active learning.",
  "action": {
    "default_popup": "index.html"
  },
  "permissions": ["scripting", "activeTab", "storage", "clipboardRead"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/namespace.js",
        "content/common.js",
        "content/modal.js",
        "content/highlight-core.js",
        "content/tags-panel.js",
        "content/clipboard.js",
        "content/popup.js",
        "content/init.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["http://localhost:5000/*","<all_urls>"]
}
